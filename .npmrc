# Use a flat-ish node_modules layout. pnpm still stores packages in .pnpm/ and
# symlinks them, but consumers see node_modules/<name> like npm/yarn.
node-linker=hoisted

# Needed so scripts like expo-modules-autolinking can resolve
# dependencies from parents of the package they are patching/reading.
shamefully-hoist=false

# Pull specific packages up to the top-level node_modules. These are the ones
# that React Native, Expo and their codegen tools look up through non-standard
# traversals (e.g. from node_modules/react-native/node_modules/@react-native/codegen/...).
public-hoist-pattern[]=*string-width*
public-hoist-pattern[]=*strip-ansi*
public-hoist-pattern[]=*wrap-ansi*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*@expo*
public-hoist-pattern[]=*expo-*
public-hoist-pattern[]=*react-native-*
public-hoist-pattern[]=*@babel/*
public-hoist-pattern[]=*@types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*hermes-*
public-hoist-pattern[]=*cliui*
public-hoist-pattern[]=*yargs*

# Allow postinstall scripts for native modules that need them.
# pnpm 8+ blocks them by default; we opt-in to the ones we trust.
# Use `pnpm approve-builds` to add more as they appear.
# auto-install-peers makes pnpm install peerDependencies automatically, matching
# yarn/npm behavior and avoiding false-positive peer warnings from RN deps.
auto-install-peers=true
strict-peer-dependencies=false
