{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 10000000,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.idea",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!**/.changeset",
      "!**/android",
      "!**/ios",
      "!**/.gradle",
      "!**/build"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "lineWidth": 120,
      "indentStyle": "space"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noParameterAssign": "off",
        "useSelfClosingElements": "off"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "warn",
          "fix": "none"
        },
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": {
          "level": "warn",
          "fix": "none"
        },
        "noUndeclaredDependencies": "off",
        "noInvalidUseBeforeDeclaration": "off",
        "noUnsafeOptionalChaining": "warn",
        "noUnsafeFinally": "warn",
        "useExhaustiveDependencies": {
          "level": "warn",
          "fix": "none"
        },
        "useHookAtTopLevel": "warn"
      },
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "warn",
        "noAsyncPromiseExecutor": "warn"
      },
      "complexity": {
        "noBannedTypes": "warn",
        "noForEach": "off",
        "useLiteralKeys": "off",
        "noUselessFragments": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useButtonType": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "**/*.test.ts", "**/__tests__/**", "**/tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUndeclaredDependencies": "off"
          },
          "suspicious": {
            "noNonNullAssertedOptionalChain": "off"
          }
        }
      }
    }
  ]
}
