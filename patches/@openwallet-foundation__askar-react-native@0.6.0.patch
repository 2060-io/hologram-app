 RCT_EXPORT_MODULE()
 
+// Treat this module as a TurboModule. This makes React Native call
+// installJSIBindingsWithRuntime:callInvoker: below when the module is created,
+// which is the only supported way to install JSI bindings under the New
+// Architecture / bridgeless mode (where [RCTBridge currentBridge] is nil and
+// the legacy bridge is compiled out via RCT_REMOVE_LEGACY_ARCH=1).
+//
+// Returning an ObjCInteropTurboModule keeps the existing RCT_EXPORT methods
+// (e.g. `install`) dispatchable without a codegen spec. Upstream, this can be
+// replaced by the generated `std::make_shared<NativeAskarSpecJSI>(params)`.
+- (std::shared_ptr<react::TurboModule>)getTurboModule:(const react::ObjCTurboModule::InitParams &)params
+{
+    return std::make_shared<react::ObjCInteropTurboModule>(params);
+}
+
+- (void)installJSIBindingsWithRuntime:(jsi::Runtime &)runtime
+                          callInvoker:(const std::shared_ptr<react::CallInvoker> &)callInvoker
+{
+    askarTurboModuleUtility::registerTurboModule(runtime, callInvoker);
+}
