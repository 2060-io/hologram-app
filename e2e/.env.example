# E2E rig env. Copy to e2e/.env and adjust per run.
#
# Three scopes live here:
#  - HOST-SIDE values: consumed by the node driver (e2e/src/run.ts + issuer.ts)
#    running on the host. These use localhost:<published-port>.
#  - APP-BUILD values: baked into the debug APK at BUILD time via
#    react-native-config (ENVFILE). The emulator reaches the host via 10.0.2.2,
#    never localhost.
#  - RIG values: docker-compose overrides for the mediator + vs-agent containers.
#
# READ THIS FIRST (did:web is HTTPS-only):
# The app reaches the mediator strictly by DID (receiveImplicitInvitation), and
# the shipping web-did-resolver only fetches https://. A plain-http
# did:web:10.0.2.2%3A4000 will NOT resolve and sign-up will hang. For a runnable
# rig you must front the mediator (and, if you use the app's auto default-service
# connect, vs-agent) with HTTPS/WSS via a tunnel (ngrok/cloudflared) or TLS
# terminator, then set the *_PUBLIC_DID / *_ENDPOINTS below to that https/wss host
# and install the front's CA into the emulator trust store if it is self-signed.
# The 10.0.2.2 values below are the plain-http fallback; they let the rig boot and
# the vs-agent inline-OOB connect work, but they do NOT complete mediator sign-up.

# ---------------------------------------------------------------------------
# HOST-SIDE (node driver on the host -> vs-agent admin REST)
# ---------------------------------------------------------------------------
# Admin REST port published by the vs-agent container (ADMIN_PORT=3002). The
# driver runs on the host, so localhost is correct here (NOT 10.0.2.2).
# NOTE: e2e/src/run.ts currently defaults VS_AGENT_ADMIN_URL to :3001 (the public
# DIDComm port). Always export this explicitly to :3002 or the issuer hits the
# wrong port and invitation/offer/proof creation fails.
VS_AGENT_ADMIN_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# APP-BUILD (baked into the APK at gradle build time; emulator-reachable only)
# ---------------------------------------------------------------------------
# Maestro target = dev-flavor applicationId (android/app/build.gradle).
APP_ID=io.twentysixty.mobileagent.dev

# Mediator the wallet boots against (receiveImplicitInvitation by DID). MUST be
# https-resolvable from inside the emulator. Replace with your tunnel host, e.g.
#   MEDIATOR_PUBLIC_DID=did:web:abcd-1234.ngrok-free.app
# The plain-http form below does NOT resolve (see header) and is a fallback only.
# NB: this value flows through the app's PERSISTED devEnvs (ConfigProvider), so it
# only re-seeds from the baked APK value on CLEAN app storage. Always `adb shell
# pm clear io.twentysixty.mobileagent.dev` (or use a fresh AVD) before a run so a
# stale persisted mediator DID does not shadow the freshly baked one.
MEDIATOR_PUBLIC_DID=did:web:10.0.2.2%3A4000

# Default 'welcome' service. Leave EMPTY to skip the app's auto default-service
# connect (which would resolve this DID over https and hit the same wall). The
# vs-agent connect is driven by the Maestro inline ?oob= flow instead. Set it to a
# https-resolvable did:web only if you intend to exercise the auto connect.
DEFAULT_SERVICE_PUBLIC_DID=
DEFAULT_SERVICE_ALIAS=Welcome to Hologram (E2E)

APP_NAME=Hologram
# Deep-link prefix the app claims. Keep https/hologram.zone for the baked app
# config; the e2e invitation itself is minted as a didcomm:// link (see
# AGENT_INVITATION_BASE_URL) so it routes to the app without App-Links verification.
BASE_INVITATION_URL=https://hologram.zone
SUPPORTED_DIDCOMM_VERSIONS=v1,v2

# ---------------------------------------------------------------------------
# RIG (docker-compose overrides; emulator-reachable hosts)
# ---------------------------------------------------------------------------
# For a real run, set these to the tunnel host (wss://<tunnel> / https://<tunnel>)
# to match the *_PUBLIC_DID above. The 10.0.2.2 values are the plain-http fallback.
MEDIATOR_AGENT_ENDPOINTS=ws://10.0.2.2:4000
MEDIATOR_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
VS_AGENT_ENDPOINTS=ws://10.0.2.2:3001
VS_AGENT_PUBLIC_API_BASE_URL=http://10.0.2.2:3001
# didcomm:// base so Android routes the OOB deep link straight to the app (the
# non-autoVerify didcomm intent-filter). The ?oob= serviceEndpoint comes from
# VS_AGENT_ENDPOINTS, so this wrapper host does not affect delivery.
AGENT_INVITATION_BASE_URL=didcomm://invite
EVENTS_BASE_URL=http://10.0.2.2:5000

# Docker build contexts (point at your local checkouts or CI checkout paths).
MEDIATOR_BUILD_CONTEXT=../../didcomm-mediator
VS_AGENT_BUILD_CONTEXT=../../verana/vs-agent-main
