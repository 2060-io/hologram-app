  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only --mode=devdebug --appId=io.twentysixty.mobileagent.dev",
    "ios": "react-native run-ios --scheme Dev",
    "start": "react-native start",
    "build": "tsc",
    "types:check": "tsc --noEmit",
    "style:check": "biome check",
    "style:fix": "biome check --write",
    "prepare": "husky install",
    "clean": "react-native-clean-project",
    "postinstall": "find node_modules -mindepth 3 -path '*/node_modules/@credo-ts' -type d -exec rm -rf {} +",
    "postversion": "react-native-version --never-amend --generate-build",
    "release": "semantic-release",
    "android:staging": "react-native run-android --active-arch-only --mode=stagingdebug --appId=io.twentysixty.mobileagent.st",
    "android:staging-release": "react-native run-android --active-arch-only --mode=stagingrelease --appId=io.twentysixty.mobileagent.st",
    "android:dev": "react-native run-android --active-arch-only --mode=devdebug --appId=io.twentysixty.mobileagent.dev",
    "android:dev-release": "react-native run-android --active-arch-only --mode=devrelease --appId=io.twentysixty.mobileagent.dev",
    "android:prod": "react-native run-android --active-arch-only --mode=proddebug --appId=io.twentysixty.mobileagent.m",
    "android:prod-release": "react-native run-android --active-arch-only --mode=prodrelease --appId=io.twentysixty.mobileagent.m",
    "ios:dev": "react-native run-ios --scheme Dev",
    "ios:staging": "react-native run-ios --scheme Staging",
    "ios:prod": "react-native run-ios --scheme Prod",
    "white-label:android": "WHITE_LABEL_DIR=verana bash ./scripts/white_label_for_android.sh",
    "white-label:ios": "WHITE_LABEL_DIR=verana bash ./scripts/white_label_for_ios.sh",
    "white-label:react-native": "WHITE_LABEL_DIR=verana bash ./scripts/white_label_for_react_native.sh"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-application",
        "expo-asset",
        "expo-constants",
        "expo-file-system"
